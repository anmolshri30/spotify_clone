{
  "package": {
    "productName": "Spotify Clone",
    "version": "0.1.0"
  },
  "build": {
    "distDir": "../frontend/dist",
    "devPath": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev"
  },
  "tauri": {
    "windows": [{ "title": "Spotify Clone" }],
    "allowlist": {
      "all": false,
      "process": { "all": true },
      "fs": { "all": false },
      "http": { "request": true },
      "shell": { "open": true }
    },
    "security": {
      "csp": "default-src 'self'"
    },
    "bundle": {
      "identifier": "com.example.spotifyclone",
      "icon": ["icons/icon.ico"],
      "targets": "all"
    },
    "updater": { "active": false },
    "cli": { "description": "Spotify Clone desktop app" },
    "path": {
      "sidecar": "../backend/dist/spotify_backend.exe"
    }
  }
}
